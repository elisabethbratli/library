server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  # API_UPSTREAM / API_HOST are substituted at container start (nginx image runs envsubst on /etc/nginx/templates).
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host ${API_HOST};
    proxy_ssl_server_name on;
  }
  location / { try_files $uri /index.html; }
}
